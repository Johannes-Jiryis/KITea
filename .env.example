# Database
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/kitea"
# Shell variables override .env.local, which overrides .env (app, Prisma and import CLI).
# Use a separate migration-role DATABASE_URL when running db:deploy.
# Supabase CA certificate PEM for verified TLS (required with the shared pooler on Vercel).
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Google OAuth (required for Google sign-in)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"
# Production requires HTTPS canonical URL, real OAuth credentials and a random secret >=32 chars.
# Only enable behind an ingress that overwrites X-Real-IP and blocks direct access.
TRUST_PROXY="false"
